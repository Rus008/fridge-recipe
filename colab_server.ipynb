 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Fridge Recipe Maker — Colab Server\n",
    "FastAPI + Qwen2-VL-2B на GPU через ngrok."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Подготовка\n",
    "Загрузи архив `fridge-recipe-maker.zip` на Google Диск в `/MyDrive/`"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from google.colab import drive\n",
    "drive.mount('/content/drive')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os, zipfile\n",
    "\n",
    "PROJECT_ZIP = '/content/fridge-recipe-maker.zip'\n",
    "EXTRACT_DIR = '/content/fridge'\n",
    "\n",
    "if not os.path.exists(EXTRACT_DIR):\n",
    "    os.makedirs(EXTRACT_DIR, exist_ok=True)\n",
    "    with zipfile.ZipFile(PROJECT_ZIP, 'r') as z:\n",
    "        z.extractall(EXTRACT_DIR)\n",
    "    print('Project extracted')\n",
    "else:\n",
    "    print('Already extracted')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "!pip install -q fastapi uvicorn pillow torch transformers accelerate sentence-transformers chromadb spacy passlib python-multipart aiosqlite sqlalchemy\n",
    "!python -m spacy download ru_core_news_md -q"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "# Ищем папку с main.py\n",
    "for root, dirs, files in os.walk(EXTRACT_DIR):\n",
    "    if 'main.py' in files:\n",
    "        PROJECT_DIR = root\n",
    "        break\n",
    "sys.path.insert(0, PROJECT_DIR)\n",
    "os.chdir(PROJECT_DIR)\n",
    "print(f'Project dir: {PROJECT_DIR}')\n",
    "print('Files:', os.listdir(PROJECT_DIR))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Проверяем GPU\n",
    "import torch\n",
    "print(f'CUDA: {torch.cuda.is_available()}')\n",
    "if torch.cuda.is_available():\n",
    "    print(f'GPU: {torch.cuda.get_device_name(0)}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Запуск сервера"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Запускаем FastAPI в фоне\n",
    "import subprocess, time, requests\n",
    "\n",
    "proc = subprocess.Popen(\n",
    "    ['uvicorn', 'main:app', '--host', '0.0.0.0', '--port', '8000', '--workers', '1', '--timeout-keep-alive', '600'],\n",
    "    cwd=PROJECT_DIR\n",
    ")\n",
    "time.sleep(15)\n",
    "r = requests.get('http://127.0.0.1:8000/users/auto', timeout=10)\n",
    "print('Server OK:', r.json())"
   ]
  },
   {
    "cell_type": "markdown",
    "metadata": {},
    "source": [
     "## 3. Проброс через Cloudflare Tunnel (без регистрации)"
    ]
   },
   {
    "cell_type": "code",
    "execution_count": null,
    "metadata": {},
    "outputs": [],
    "source": [
     "# Скачиваем cloudflared и пробрасываем порт\n",
     "!wget -q https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64 -O cloudflared\n",
     "!chmod +x cloudflared\n",
     "import subprocess, time, re, requests\n",
     "\n",
     "proc = subprocess.Popen(['./cloudflared', 'tunnel', '--url', 'http://127.0.0.1:8000'], stdout=subprocess.PIPE, stderr=subprocess.PIPE)\n",
     "time.sleep(5)\n",
     "out = proc.stderr.read().decode()\n",
     "match = re.search(r'https://[a-zA-Z0-9-]+\.trycloudflare\\.com', out)\n",
     "if match:\n",
     "    public_url = match.group(0)\n",
     "    print(f'\\n=== ПУБЛИЧНЫЙ URL ===')\n",
     "    print(f'{public_url}')\n",
     "    print(f'\\nВведи этот URL в Android APK')\n",
     "else:\n",
     "    print('Tunnel output:', out[:500])"
    ]
   },
   {
    "cell_type": "markdown",
    "metadata": {},
    "source": [
     "Сессия будет работать, пока Colab не отключит. При перезапуске повтори шаги 2-3."
    ]
   }
